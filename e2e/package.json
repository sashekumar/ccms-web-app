{
  "name": "ccms-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for CCMS Web Application",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:auth": "playwright test tests/auth",
    "test:users": "playwright test tests/users",
    "test:roles": "playwright test tests/roles",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4200",
    "install:browsers": "playwright install",
    "db:up": "docker-compose -f docker/docker-compose.yml up -d",
    "db:down": "docker-compose -f docker/docker-compose.yml down",
    "db:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "db:restart": "docker-compose -f docker/docker-compose.yml restart"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "ccms"
  ],
  "author": "CCMS Development Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.42.1",
    "@types/mssql": "^9.1.4",
    "@types/node": "^20.11.24",
    "mssql": "^10.0.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
